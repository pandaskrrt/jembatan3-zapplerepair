generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

// ─────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────

enum Role {
  ADMIN
  USER
  STOCK_AUDIT
}

enum CurrencyType {
  IDR
  SGD
}

enum AuditStatus {
  DRAFT       // sedang dikerjakan auditor
  COMPLETED   // sudah submit, langsung final
}

enum AuditItemStatus {
  MATCH        // sistem = fisik
  MISMATCH     // sistem ≠ fisik, stok diupdate ikut fisik
  MISSING      // ada di sistem, tidak ada di fisik → stok jadi 0
  NEW_ENTRY    // tidak ada di sistem, baru ditemukan → card baru dibuat
}

enum CardHistoryAction {
  CREATED        // card baru dibuat dari NEW_ENTRY
  STOCK_UPDATED  // stok diupdate dari MISMATCH
  MARKED_MISSING // ditandai hilang dari MISSING
  RESTORED       // pernah MISSING, sekarang ketemu lagi di audit berikutnya
}

// ─────────────────────────────────────────
// USER
// ─────────────────────────────────────────

model User {
  id             String        @id @default(cuid())
  username       String        @unique
  name           String
  password       String
  role           Role

  orderHistories OrderHistory[]
  audits         StockAudit[]
  cardHistories  CardHistory[]
}

// ─────────────────────────────────────────
// CABINET & SECTION
// ─────────────────────────────────────────

model Cabinet {
  id       Int       @id @default(autoincrement())
  name     String
  maxSlots Int
  sections Section[]
}

model Section {
  id        Int          @id @default(autoincrement())
  name      String
  type      String
  cabinet   Cabinet?     @relation(fields: [cabinetId], references: [id], onDelete: Cascade)
  cabinetId Int?
  cards     Card[]
  audits    StockAudit[]
}

// ─────────────────────────────────────────
// CARD
// ─────────────────────────────────────────

model Card {
  id             Int              @id @default(autoincrement())
  name           String
  stock          Int
  location       String
  category       String
  subCategory    String
  videoUrl       String?
  imageUrl       String
  qrCustomUrl    String?
  section        Section?         @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  sectionId      Int?

  prices         Price[]
  orderHistories OrderHistory[]
  auditItems     StockAuditItem[]
  histories      CardHistory[]
}

// ─────────────────────────────────────────
// PRICE
// ─────────────────────────────────────────

model Price {
  id        Int          @id @default(autoincrement())
  cardId    Int
  card      Card         @relation(fields: [cardId], references: [id], onDelete: Cascade)
  currency  CurrencyType
  amount    Int
  priceNote String
  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([cardId, currency])
}

// ─────────────────────────────────────────
// ORDER HISTORY
// ─────────────────────────────────────────

model OrderHistory {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  stripeId  String   @unique
  amount    Int
  status    String
  user      User?    @relation(fields: [userId], references: [id])
  userId    String?
  card      Card?    @relation(fields: [cardId], references: [id])
  cardId    Int?
}

// ─────────────────────────────────────────
// STOCK AUDIT
// ─────────────────────────────────────────

model StockAudit {
  id          String      @id @default(cuid())
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  completedAt DateTime?   // diisi saat submit

  auditorId   String
  auditor     User        @relation(fields: [auditorId], references: [id])

  sectionId   Int
  section     Section     @relation(fields: [sectionId], references: [id])

  status      AuditStatus @default(DRAFT)
  note        String?

  // Summary snapshot saat completed (untuk laporan)
  totalCards    Int?       // total card yang diaudit
  totalMatch    Int?       // jumlah MATCH
  totalMismatch Int?       // jumlah MISMATCH
  totalMissing  Int?       // jumlah MISSING
  totalNewEntry Int?       // jumlah NEW_ENTRY

  items         StockAuditItem[]
  cardHistories CardHistory[]
}

// ─────────────────────────────────────────
// STOCK AUDIT ITEM
// ─────────────────────────────────────────

model StockAuditItem {
  id          Int             @id @default(autoincrement())

  audit       StockAudit      @relation(fields: [auditId], references: [id], onDelete: Cascade)
  auditId     String

  // Nullable karena NEW_ENTRY belum punya cardId saat audit
  // Setelah submit, cardId diisi dengan card yang baru dibuat
  card        Card?           @relation(fields: [cardId], references: [id])
  cardId      Int?

  itemStatus  AuditItemStatus

  systemStock   Int?          // null kalau NEW_ENTRY
  physicalStock Int?          // null kalau MISSING

  // Data sementara untuk NEW_ENTRY
  // Setelah submit langsung dipakai buat card baru
  newCardName        String?
  newCardCategory    String?
  newCardSubCategory String?
  newCardImageUrl    String?
  newCardLocation    String?
  newCardPriceIDR    Int?
  newCardPriceSGD    Int?

  note        String?

  @@unique([auditId, cardId])
}

// ─────────────────────────────────────────
// CARD HISTORY
// ─────────────────────────────────────────

model CardHistory {
  id          String            @id @default(cuid())
  createdAt   DateTime          @default(now())

  card        Card              @relation(fields: [cardId], references: [id])
  cardId      Int

  action      CardHistoryAction

  // Snapshot nilai lama & baru
  oldStock    Int?
  newStock    Int?

  // Siapa yang trigger
  triggeredBy String
  user        User              @relation(fields: [triggeredBy], references: [id])

  // Dari audit mana
  auditId     String?
  audit       StockAudit?       @relation(fields: [auditId], references: [id])

  note        String?
}