generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

// ─────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────

enum Role {
  SUPER_ADMIN
  ADMIN
  USER
  STOCK_AUDIT
}

enum CurrencyType {
  IDR
}

enum AuditStatus {
  DRAFT
  COMPLETED
}

enum AuditItemStatus {
  MATCH
  MISMATCH
  MISSING
  NEW_ENTRY
}

enum ItemHistoryAction {
  CREATED
  STOCK_UPDATED
  MARKED_MISSING
  RESTORED
}

enum ReportStatus {
  DRAFT
  PENDING_SIGN
  PARTIALLY_SIGNED
  COMPLETED
  REJECTED
}

// ─────────────────────────────────────────
// USER
// ─────────────────────────────────────────

model User {
  id       String  @id @default(cuid())
  username String  @unique
  name     String
  password String
  role     Role
  isActive Boolean @default(true)

  orderHistories   OrderHistory[]
  audits           StockAudit[]
  itemHistories    ItemHistory[]
  reportSignatures ReportSignature[]
}

// ─────────────────────────────────────────
// CABINET & SECTION
// ─────────────────────────────────────────

model Cabinet {
  id       Int       @id @default(autoincrement())
  name     String
  maxSlots Int
  sections Section[]
}

model Section {
  id        Int          @id @default(autoincrement())
  name      String
  type      String
  cabinet   Cabinet?     @relation(fields: [cabinetId], references: [id], onDelete: Cascade)
  cabinetId Int?
  items     Item[]
  audits    StockAudit[]
}

// ─────────────────────────────────────────
// ITEM (Barang Stock Gudang)
// ─────────────────────────────────────────

model Item {
  id           Int      @id @default(autoincrement())
  name         String
  stock        Int
  location     String
  category     String
  subCategory  String
  serialNumber String?  @unique
  videoUrl     String?
  imageUrl     String?
  qrCustomUrl  String?
  section      Section? @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  sectionId    Int?

  price          Price? // Harga jual IDR (one-to-one)
  costPrice      CostPrice? // Harga modal IDR (one-to-one)
  orderHistories OrderHistory[]
  auditItems     StockAuditItem[]
  histories      ItemHistory[]
}

// ─────────────────────────────────────────
// PRICE (Harga Jual IDR)
// ─────────────────────────────────────────

model Price {
  id        Int      @id @default(autoincrement())
  itemId    Int      @unique
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  amount    Int // Harga jual dalam Rupiah
  priceNote String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────
// COST PRICE (Harga Modal IDR)
// ─────────────────────────────────────────

model CostPrice {
  id        Int      @id @default(autoincrement())
  itemId    Int      @unique
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  amount    Int // Harga modal dalam Rupiah
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────
// ORDER HISTORY
// ─────────────────────────────────────────

model OrderHistory {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  stripeId  String   @unique
  amount    Int
  status    String
  user      User?    @relation(fields: [userId], references: [id])
  userId    String?
  item      Item?    @relation(fields: [itemId], references: [id])
  itemId    Int?
}

// ─────────────────────────────────────────
// STOCK AUDIT
// ─────────────────────────────────────────

model StockAudit {
  id          String    @id @default(cuid())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  auditorId String
  auditor   User   @relation(fields: [auditorId], references: [id])

  sectionId Int
  section   Section @relation(fields: [sectionId], references: [id])

  status AuditStatus @default(DRAFT)
  note   String?

  totalItems    Int?
  totalMatch    Int?
  totalMismatch Int?
  totalMissing  Int?
  totalNewEntry Int?

  items         StockAuditItem[]
  itemHistories ItemHistory[]
  report        Report?
}

// ─────────────────────────────────────────
// STOCK AUDIT ITEM
// ─────────────────────────────────────────

model StockAuditItem {
  id      Int        @id @default(autoincrement())
  auditId String
  audit   StockAudit @relation(fields: [auditId], references: [id], onDelete: Cascade)

  item   Item? @relation(fields: [itemId], references: [id])
  itemId Int?

  itemStatus AuditItemStatus

  systemStock   Int?
  physicalStock Int?

  newItemName        String?
  newItemCategory    String?
  newItemSubCategory String?
  newItemImageUrl    String?
  newItemLocation    String?
  newItemPriceIDR    Int? // Harga jual IDR untuk item baru
  newItemCostPrice   Int? // Harga modal IDR untuk item baru

  note String?

  @@unique([auditId, itemId])
}

// ─────────────────────────────────────────
// ITEM HISTORY
// ─────────────────────────────────────────

model ItemHistory {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  itemId Int
  item   Item @relation(fields: [itemId], references: [id])

  action ItemHistoryAction

  oldStock Int?
  newStock Int?

  triggeredBy String
  user        User   @relation(fields: [triggeredBy], references: [id])

  auditId String?
  audit   StockAudit? @relation(fields: [auditId], references: [id])

  note String?
}

// ─────────────────────────────────────────
// REPORT (LAPORAN AUDIT)
// ─────────────────────────────────────────

model Report {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  auditId String     @unique
  audit   StockAudit @relation(fields: [auditId], references: [id], onDelete: Cascade)

  // Simpan daftar ID penanggung jawab sebagai JSON
  responsibleIds Json?

  // Auditor signature
  auditorSignature String?   @db.LongText
  auditorSignedAt  DateTime?

  status ReportStatus @default(DRAFT)

  notes String?

  completedAt DateTime?

  signatures ReportSignature[]

  // Timestamp untuk penanggung jawab
  responsibleSignedAt1 DateTime?
  responsibleSignedAt2 DateTime?
}

// ─────────────────────────────────────────
// REPORT SIGNATURE (TANDA TANGAN)
// ─────────────────────────────────────────

model ReportSignature {
  id        String    @id @default(cuid())
  createdAt DateTime  @default(now())
  signedAt  DateTime?

  reportId String
  report   Report @relation(fields: [reportId], references: [id], onDelete: Cascade)

  signerId String
  signer   User   @relation(fields: [signerId], references: [id])

  order Int

  signature     String? @db.LongText
  signatureType String?

  ipAddress String?
  userAgent String?

  note String?

  @@unique([reportId, order])
}
