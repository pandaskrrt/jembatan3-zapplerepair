generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

// ─────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────

enum Role {
  SUPER_ADMIN
  ADMIN
  USER
  STOCK_AUDIT
}

enum CurrencyType {
  IDR
  SGD
}

enum AuditStatus {
  DRAFT
  COMPLETED
}

enum AuditItemStatus {
  MATCH
  MISMATCH
  MISSING
  NEW_ENTRY
}

enum CardHistoryAction {
  CREATED
  STOCK_UPDATED
  MARKED_MISSING
  RESTORED
}

enum ReportStatus {
  DRAFT
  PENDING_SIGN
  PARTIALLY_SIGNED
  COMPLETED
  REJECTED
}

// ─────────────────────────────────────────
// USER
// ─────────────────────────────────────────

model User {
  id             String        @id @default(cuid())
  username       String        @unique
  name           String
  password       String
  role           Role
  isActive       Boolean       @default(true)

  orderHistories OrderHistory[]
  audits         StockAudit[]
  cardHistories  CardHistory[]
  reportSignatures ReportSignature[]
  
  // HAPUS relasi yang tidak diperlukan - cukup pakai responsibleIds JSON
}

// ─────────────────────────────────────────
// CABINET & SECTION
// ─────────────────────────────────────────

model Cabinet {
  id       Int       @id @default(autoincrement())
  name     String
  maxSlots Int
  sections Section[]
}

model Section {
  id        Int          @id @default(autoincrement())
  name      String
  type      String
  cabinet   Cabinet?     @relation(fields: [cabinetId], references: [id], onDelete: Cascade)
  cabinetId Int?
  cards     Card[]
  audits    StockAudit[]
}

// ─────────────────────────────────────────
// CARD
// ─────────────────────────────────────────

model Card {
  id             Int              @id @default(autoincrement())
  name           String
  stock          Int
  location       String
  category       String
  subCategory    String
  videoUrl       String?
  imageUrl       String
  qrCustomUrl    String?
  section        Section?         @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  sectionId      Int?

  prices         Price[]
  orderHistories OrderHistory[]
  auditItems     StockAuditItem[]
  histories      CardHistory[]
}

// ─────────────────────────────────────────
// PRICE
// ─────────────────────────────────────────

model Price {
  id        Int          @id @default(autoincrement())
  cardId    Int
  card      Card         @relation(fields: [cardId], references: [id], onDelete: Cascade)
  currency  CurrencyType
  amount    Int
  priceNote String
  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([cardId, currency])
}

// ─────────────────────────────────────────
// ORDER HISTORY
// ─────────────────────────────────────────

model OrderHistory {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  stripeId  String   @unique
  amount    Int
  status    String
  user      User?    @relation(fields: [userId], references: [id])
  userId    String?
  card      Card?    @relation(fields: [cardId], references: [id])
  cardId    Int?
}

// ─────────────────────────────────────────
// STOCK AUDIT
// ─────────────────────────────────────────

model StockAudit {
  id          String      @id @default(cuid())
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  completedAt DateTime?

  auditorId   String
  auditor     User        @relation(fields: [auditorId], references: [id])

  sectionId   Int
  section     Section     @relation(fields: [sectionId], references: [id])

  status      AuditStatus @default(DRAFT)
  note        String?

  totalCards    Int?
  totalMatch    Int?
  totalMismatch Int?
  totalMissing  Int?
  totalNewEntry Int?

  items         StockAuditItem[]
  cardHistories CardHistory[]
  report        Report?
}

// ─────────────────────────────────────────
// STOCK AUDIT ITEM
// ─────────────────────────────────────────

model StockAuditItem {
  id          Int             @id @default(autoincrement())
  auditId     String
  audit       StockAudit      @relation(fields: [auditId], references: [id], onDelete: Cascade)

  card        Card?           @relation(fields: [cardId], references: [id])
  cardId      Int?

  itemStatus  AuditItemStatus

  systemStock   Int?
  physicalStock Int?

  newCardName        String?
  newCardCategory    String?
  newCardSubCategory String?
  newCardImageUrl    String?
  newCardLocation    String?
  newCardPriceIDR    Int?
  newCardPriceSGD    Int?

  note        String?

  @@unique([auditId, cardId])
}

// ─────────────────────────────────────────
// CARD HISTORY
// ─────────────────────────────────────────

model CardHistory {
  id          String            @id @default(cuid())
  createdAt   DateTime          @default(now())

  cardId      Int
  card        Card              @relation(fields: [cardId], references: [id])

  action      CardHistoryAction

  oldStock    Int?
  newStock    Int?

  triggeredBy String
  user        User              @relation(fields: [triggeredBy], references: [id])

  auditId     String?
  audit       StockAudit?       @relation(fields: [auditId], references: [id])

  note        String?
}

// ─────────────────────────────────────────
// REPORT (LAPORAN AUDIT)
// ─────────────────────────────────────────

model Report {
  id          String        @id @default(cuid())
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  
  auditId     String        @unique
  audit       StockAudit    @relation(fields: [auditId], references: [id], onDelete: Cascade)
  
  // Simpan daftar ID penanggung jawab sebagai JSON
  responsibleIds Json?
  
  // Auditor signature
  auditorSignature String?   @db.LongText
  auditorSignedAt   DateTime?
  
  status      ReportStatus  @default(DRAFT)
  
  notes       String?
  
  completedAt DateTime?
  
  signatures  ReportSignature[]
  
  // Timestamp untuk penanggung jawab
  responsibleSignedAt1 DateTime?
  responsibleSignedAt2 DateTime?
}

// ─────────────────────────────────────────
// REPORT SIGNATURE (TANDA TANGAN)
// ─────────────────────────────────────────

model ReportSignature {
  id          String        @id @default(cuid())
  createdAt   DateTime      @default(now())
  signedAt    DateTime?
  
  reportId    String
  report      Report        @relation(fields: [reportId], references: [id], onDelete: Cascade)
  
  signerId    String
  signer      User          @relation(fields: [signerId], references: [id])
  
  order       Int
  
  signature   String? @db.LongText
  signatureType String?
  
  ipAddress   String?
  userAgent   String?
  
  note        String?
  
  @@unique([reportId, order])
}