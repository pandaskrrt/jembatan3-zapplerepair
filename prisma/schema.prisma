generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

// ─────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────

enum Role {
  SUPER_ADMIN
  ADMIN
  USER
  STOCK_AUDIT
}

enum CurrencyType {
  IDR
}

enum ItemCategory {
  ReadySale
  NoReadySale
  Accessories
  Sparepart
}

enum SerialStatus {
  AVAILABLE
  SOLD
  USED
}

enum AuditStatus {
  DRAFT
  COMPLETED
}

enum AuditItemStatus {
  MATCH
  MISMATCH
  MISSING
  NEW_ENTRY
}

enum ItemHistoryAction {
  CREATED
  STOCK_UPDATED
  MARKED_MISSING
  RESTORED
  SOFT_DELETED
  SECTION_DELETED
  CABINET_DELETED
  MOVED_TO_PERMANENT
  RETURNED_TO_ORIGIN
  BROKEN_DOWN
  TRANSFERRED
  MOVED_IN
  ASSEMBLED
}

enum ReportStatus {
  DRAFT
  PENDING_SIGN
  PARTIALLY_SIGNED
  COMPLETED
  REJECTED
}

enum CabinetLogAction {
  CABINET_CREATED
  CABINET_UPDATED
  CABINET_DELETED
  SECTION_CREATED
  SECTION_UPDATED
  SECTION_DELETED
  ITEM_ADDED
  ITEM_REMOVED
  ITEM_MOVED_IN
  ITEM_MOVED_OUT
  ITEM_RESTORED
}

enum RestoreStatus {
  APPROVED
  REJECTED
}

// ─────────────────────────────────────────
// USER
// ─────────────────────────────────────────

model User {
  id        String    @id @default(cuid())
  username  String    @unique
  name      String
  password  String
  role      Role
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt  // nullable — data lama tidak error

  orderHistories   OrderHistory[]
  audits           StockAudit[]
  itemHistories    ItemHistory[]
  reportSignatures ReportSignature[]
  cabinetLogs      CabinetLog[]
  restoreLogs      RestoreLog[]
  serviceForms     ServiceForm[]
}

// ─────────────────────────────────────────
// CABINET
// ─────────────────────────────────────────

model Cabinet {
  id          Int       @id @default(autoincrement())
  name        String
  maxSlots    Int
  isProtected Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime? @updatedAt  // nullable — data lama tidak error

  deletedAt  DateTime?
  deletedBy  String?
  deleteNote String?

  sections Section[]
  logs     CabinetLog[]
}

// ─────────────────────────────────────────
// SECTION
// ─────────────────────────────────────────

model Section {
  id          Int       @id @default(autoincrement())
  name        String
  type        String
  cabinetId   Int?
  cabinet     Cabinet?  @relation(fields: [cabinetId], references: [id], onDelete: Restrict)
  isProtected Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime? @updatedAt

  // FIELD UNTUK LOCK
  lockedByAuditId   String?
  lockedUntil       DateTime?

  deletedAt  DateTime?
  deletedBy  String?
  deleteNote String?

  items  Item[]
  audits StockAudit[]
  logs   CabinetLog[]
}

// ─────────────────────────────────────────
// ITEM
// ─────────────────────────────────────────

model Item {
  id           Int       @id @default(autoincrement())
  name         String
  stock        Int
  location     String
  category     String
  subCategory  String
  serialNumber String?
  videoUrl     String?
  imageUrl     String?
  qrCustomUrl  String?
  sectionId    Int?
  section      Section?  @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime? @updatedAt  // nullable — data lama tidak error

  deletedAt              DateTime?
  deletedBy              String?
  deleteReason           String?
  deletedFromSectionId   Int?
  deletedFromCabinetId   Int?
  deletedFromSectionName String?
  deletedFromCabinetName String?

  // ── BARANG CUSTOMER / PERMANENT LOCATION ──
  isCustomer         Boolean  @default(false)
  originSectionId    Int?
  originSectionName  String?

  price          Price?
  costPrice      CostPrice?
  orderHistories OrderHistory[]
  auditItems     StockAuditItem[]
  histories      ItemHistory[]
  restoreLogs    RestoreLog[]
  cabinetLogs    CabinetLog[]
  serials        ItemSerial[]

  serviceStockUsage ServiceStockUsage[]
  serviceFormItems  ServiceFormItem[]
}

// ─────────────────────────────────────────
// ITEM SERIAL
// ─────────────────────────────────────────

model ItemSerial {
  id            Int            @id @default(autoincrement())
  serialNumber  String?        @unique
  grade         String?
  category      ItemCategory   @default(ReadySale)
  status        SerialStatus   @default(AVAILABLE)
  spec          String?        @db.Text
  price         Int            @default(0)
  costPrice     Int            @default(0)
  videoUrl      String?
  qrCustomUrl   String?
  isDisplay     Boolean        @default(false)
  itemId        Int
  item          Item           @relation(fields: [itemId], references: [id], onDelete: Cascade)
  images        ItemSerialImage[]
  serviceStockUsages ServiceStockUsage[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime?      @updatedAt

  @@index([itemId])
  @@index([serialNumber])
}

// ─────────────────────────────────────────
// ITEM SERIAL IMAGE
// ─────────────────────────────────────────

model ItemSerialImage {
  id        Int       @id @default(autoincrement())
  url       String
  isMain    Boolean   @default(false)
  sortOrder Int       @default(0)
  serialId  Int
  serial    ItemSerial @relation(fields: [serialId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
}

// ─────────────────────────────────────────
// SERVICE STOCK USAGE
// ─────────────────────────────────────────

model ServiceStockUsage {
  id        Int      @id @default(autoincrement())
  itemId    Int
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Restrict)
  serialId  Int?
  serial    ItemSerial? @relation(fields: [serialId], references: [id], onDelete: SetNull)
  quantity  Int      @default(1)
  serviceNumber String
  note      String?
  usedAt    DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([serviceNumber])
  @@index([itemId])
  @@index([serialId])
}

// ─────────────────────────────────────────
// PRICE
// ─────────────────────────────────────────

model Price {
  id        Int      @id @default(autoincrement())
  itemId    Int      @unique
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  amount    Int
  priceNote String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────
// COST PRICE
// ─────────────────────────────────────────

model CostPrice {
  id        Int      @id @default(autoincrement())
  itemId    Int      @unique
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  amount    Int
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────
// ORDER HISTORY
// ─────────────────────────────────────────

model OrderHistory {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  stripeId  String   @unique
  amount    Int
  status    String
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  itemId    Int?
  item      Item?    @relation(fields: [itemId], references: [id])
}

// ─────────────────────────────────────────
// STOCK AUDIT
// ─────────────────────────────────────────

model StockAudit {
  id          String    @id @default(cuid())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  auditorId String
  auditor   User   @relation(fields: [auditorId], references: [id])

  sectionId Int
  section   Section @relation(fields: [sectionId], references: [id])

  status AuditStatus @default(DRAFT)
  note   String?

  totalItems    Int?
  totalMatch    Int?
  totalMismatch Int?
  totalMissing  Int?
  totalNewEntry Int?

  items         StockAuditItem[]
  itemHistories ItemHistory[]
  report        Report?
}

// ─────────────────────────────────────────
// STOCK AUDIT ITEM
// ─────────────────────────────────────────

model StockAuditItem {
  id        Int        @id @default(autoincrement())
  auditId   String
  audit     StockAudit @relation(fields: [auditId], references: [id], onDelete: Cascade)
  itemId    Int?
  item      Item?      @relation(fields: [itemId], references: [id])
  createdAt DateTime   @default(now())
  updatedAt DateTime?  @updatedAt  // nullable — data lama tidak error

  itemStatus AuditItemStatus

  systemStock   Int?
  physicalStock Int?

  newItemName        String?
  newItemCategory    String?
  newItemSubCategory String?
  newItemImageUrl    String?
  newItemLocation    String?
  newItemPriceIDR    Int?
  newItemCostPrice   Int?

  note String?

  @@unique([auditId, itemId])
}

// ─────────────────────────────────────────
// ITEM HISTORY
// ─────────────────────────────────────────

model ItemHistory {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  itemId Int
  item   Item @relation(fields: [itemId], references: [id])

  action ItemHistoryAction

  oldStock Int?
  newStock Int?

  triggeredBy String?
  user        User?   @relation(fields: [triggeredBy], references: [id])

  auditId String?
  audit   StockAudit? @relation(fields: [auditId], references: [id])

  oldValue Json?
  newValue Json?
  note     String?
}

// ─────────────────────────────────────────
// CABINET LOG
// ─────────────────────────────────────────

model CabinetLog {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  cabinetId   Int?
  cabinetName String?
  sectionId   Int?
  sectionName String?
  itemId      Int?
  itemName    String?
  item        Item? @relation(fields: [itemId], references: [id])

  action CabinetLogAction

  performedById String
  performedBy   User   @relation(fields: [performedById], references: [id])

  onBehalfOf String?
  oldValue   Json?
  newValue   Json?
  note       String?

  cabinet Cabinet? @relation(fields: [cabinetId], references: [id])
  section Section? @relation(fields: [sectionId], references: [id])
}

// ─────────────────────────────────────────
// SERVICE FORM
// ─────────────────────────────────────────

enum ServiceFormStatus {
  DRAFT
  IN_PROGRESS
  WAITING_APPROVAL
  COMPLETED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  PENDING
  PAID
  CANCELLED
}

model ServiceForm {
  id               String            @id @default(cuid())
  serviceNumber    String            @unique
  customerName     String
  customerPhone    String?
  deviceType       String
  deviceBrand      String?
  deviceModel      String?
  deviceIMEI       String?
  problemDescription String?         @db.Text
  status           ServiceFormStatus @default(DRAFT)

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  items         ServiceFormItem[]
  invoice       ServiceFormInvoice?
}

model ServiceFormItem {
  id            Int         @id @default(autoincrement())
  serviceFormId String
  serviceForm   ServiceForm @relation(fields: [serviceFormId], references: [id], onDelete: Cascade)

  itemId   Int
  item     Item     @relation(fields: [itemId], references: [id])
  quantity Int      @default(1)
  note     String?

  createdAt DateTime @default(now())
}

enum InvoiceItemCategory {
  JASA_SERVICE
  STOCK_GUDANG
  ALAT_KERJA
  JASA_MITRA
  PEMBELIAN
  STOK_CUSTOMER
}

model ServiceFormInvoice {
  id            String        @id @default(cuid())
  serviceFormId String        @unique
  serviceForm   ServiceForm   @relation(fields: [serviceFormId], references: [id], onDelete: Cascade)

  invoiceNumber String
  grandTotal    Int           @default(0)
  status        InvoiceStatus @default(DRAFT)

  items ServiceFormInvoiceItem[]

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt
}

model ServiceFormInvoiceItem {
  id          Int                  @id @default(autoincrement())
  invoiceId   String
  invoice     ServiceFormInvoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  category    InvoiceItemCategory
  description String
  quantity    Int                  @default(1)
  unitPrice   Int                  @default(0)
  totalPrice  Int                  @default(0)

  createdAt DateTime @default(now())
}

// ─────────────────────────────────────────
// RESTORE LOG
// ─────────────────────────────────────────

model RestoreLog {
  id         String    @id @default(cuid())
  createdAt  DateTime  @default(now())
  executedAt DateTime?

  itemId Int
  item   Item @relation(fields: [itemId], references: [id])

  restoredById String
  restoredBy   User   @relation(fields: [restoredById], references: [id])

  status RestoreStatus @default(APPROVED)

  restoredToSectionId Int?
  note                String?
}

// ─────────────────────────────────────────
// PERIODIC REPORT
// ─────────────────────────────────────────

model PeriodicReport {
  id        String    @id @default(cuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt  // nullable — aman untuk data baru

  periodStart DateTime
  periodEnd   DateTime
  month       Int
  year        Int
  weekOfMonth Int

  totalAuditCount    Int @default(0)
  totalItemsAdded    Int @default(0)
  totalItemsDeleted  Int @default(0)
  totalItemsRestored Int @default(0)
  totalStockChanged  Int @default(0)

  createdById String

  status ReportStatus @default(DRAFT)
  notes  String?

  auditIds        Json?
  summarySnapshot Json?

  @@unique([month, year, weekOfMonth])
}

// ─────────────────────────────────────────
// REPORT
// ─────────────────────────────────────────

model Report {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  auditId String     @unique
  audit   StockAudit @relation(fields: [auditId], references: [id], onDelete: Cascade)

  responsibleIds   Json?
  auditorSignature String?   @db.LongText
  auditorSignedAt  DateTime?

  status ReportStatus @default(DRAFT)
  notes  String?

  completedAt DateTime?

  signatures ReportSignature[]

  responsibleSignedAt1 DateTime?
  responsibleSignedAt2 DateTime?
}

// ─────────────────────────────────────────
// REPORT SIGNATURE
// ─────────────────────────────────────────

model ReportSignature {
  id        String    @id @default(cuid())
  createdAt DateTime  @default(now())
  signedAt  DateTime?

  reportId String
  report   Report @relation(fields: [reportId], references: [id], onDelete: Cascade)

  signerId String
  signer   User   @relation(fields: [signerId], references: [id])

  order Int

  signature     String? @db.LongText
  signatureType String?

  ipAddress String?
  userAgent String?

  note String?

  @@unique([reportId, order])
}

// ─────────────────────────────────────────
// INCOMING ITEM — Barang Masuk dari service form (jangan diubah)
// ─────────────────────────────────────────

model IncomingItem {
  id                Int       @id @default(autoincrement())
  name              String
  serialNumber      String?
  quantity          Int       @default(1)
  costPrice         Int       @default(0)
  sellPrice         Int       @default(0)
  category          String?   // kategori dari pengirim (Sparepart/Accessories)
  source            String    @default("Roxy")
  referenceNo       String?
  note              String?
  status            String    @default("PENDING")
  targetCabinetId   Int?
  targetSectionId   Int?
  targetItemId      Int?
  confirmedAt       DateTime?
  confirmedBy       String?
  signedAt          DateTime?
  createdById       String?
  senderName        String?
  senderSignature   String?   @db.Text
  receiverName      String?
  receiverSignature String?   @db.Text
  pdfDocument       String?   @db.LongText
  pdfDocumentFinal  String?   @db.LongText
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

// ─────────────────────────────────────────
// INCOMING ITEM CABANG — Barang masuk antar cabang (Roxy → Jembatan 3)
// ─────────────────────────────────────────

model IncomingItemCabang {
  id                Int       @id @default(autoincrement())
  name              String
  serialNumber      String?
  quantity          Int       @default(1)
  costPrice         Int       @default(0)
  sellPrice         Int       @default(0)
  category          String?   // kategori dari pengirim (ReadySale/Sparepart/Accessories)
  source            String    @default("Roxy")
  referenceNo       String?
  note              String?
  status            String    @default("PENDING")
  targetCabinetId   Int?
  targetSectionId   Int?
  targetItemId      Int?
  confirmedAt       DateTime?
  confirmedBy       String?
  signedAt          DateTime?
  createdById       String?
  senderName        String?
  senderSignature   String?   @db.Text
  receiverName      String?
  receiverSignature String?   @db.Text
  pdfDocument       String?   @db.LongText
  pdfDocumentFinal  String?   @db.LongText
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

// ─────────────────────────────────────────
// ITEM ASSEMBLY
// ─────────────────────────────────────────

model ItemAssembly {
  id              Int       @id @default(autoincrement())
  targetSerialId  Int
  partSerialId    Int?
  partName        String?
  partCategory    String?
  partCostPrice   Int       @default(0)
  partSellPrice   Int       @default(0)
  status          String    @default("IN_PROGRESS")
  stepOrder       Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime? @updatedAt
}
